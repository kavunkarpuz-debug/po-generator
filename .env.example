# === WINDOWS ENV'DEN GELİR (projeye yazmana gerek yok) ===
# GOOGLE_API_KEY — Windows User Environment Variables'ta tanımlı
# config.py GOOGLE_API_KEY'i otomatik kullanır (LLM_API_KEY fallback)

# === PROJEYE ÖZEL (bu dosyaya yaz) ===
LLM_PROVIDER='google'
LLM_MODEL='gemini-3.1-pro-preview'
TEMPLATE_READY='True'
USE_DOCX='False'
